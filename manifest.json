{
  "manifest_version": 3,
  "name": "Resume Podcast - JN",
  "version": "1.0.0",
  "description": "Salva e restaura o progresso dos podcasts do Jovem Nerd de onde você parou.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.jovemnerd.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
